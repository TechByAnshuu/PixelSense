# ========================================================
# PixelSense — Git Ignore Configuration
# ========================================================

# ── Dependencies ─────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ── Build & Distribution Outputs ─────────────────────────
dist/
**/dist/
build/
**/build/
out/
infra/.builds/
*.zip
*.tar.gz

# ── Environment & Secrets (Never commit secrets) ─────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.cer

# ── Terraform ────────────────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
# Sensitive variables files (never commit real secrets)
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# ── Logs & Debugging ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ───────────────────────────────────
coverage/
**/coverage/
.nyc_output/

# ── Operating System Files ───────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE & Editor Settings ────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
